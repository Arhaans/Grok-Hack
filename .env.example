# Copy to .env.local (never commit that file)
XAI_API_KEY=                     # Grok for the buyer's decision step; scripted fallback without it
XAI_MODEL=                       # optional, e.g. grok-4; auto-picked from your account's model list if empty
PRISM_SIGNING_SECRET=change-me   # signs merchant offers
GROK_AGENT_SECRET=change-me-too  # key the demo buyer agent signs its requests with
FINGERPRINT_URL=http://localhost:8765   # LLMmap sidecar
